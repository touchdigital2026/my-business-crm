# ============================================================
# חיבור לענן (Supabase)
# 1. שכפל את הקובץ הזה ושנה את שמו ל: .env.local
# 2. הדבק את שני הערכים מלוח הבקרה של Supabase
#    (Settings -> API Keys / Data API)
# 3. הפעל מחדש את המערכת (סגור את החלון ולחץ שוב על הפעלה.command)
#
# בלי הקובץ הזה המערכת רצה במצב דמו - הכל עובד, כלום לא נשמר.
# ============================================================
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
