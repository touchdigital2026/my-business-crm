#!/bin/bash
# ============================================================
# הפעלת מערכת ה-CRM בלחיצה כפולה.
# הקובץ מעדכן את הקוד מהשרת, מתקין מה שחסר, ומפעיל את המערכת.
# לעצירה: פשוט סוגרים את החלון הזה (ולוחצים "סיים" אם נשאלים).
# ============================================================
cd "$(dirname "$0")" || exit 1

clear
echo "======================================"
echo "   CRM - מערכת ניהול לקוחות"
echo "======================================"
echo ""
echo "[1/3] מושך את הגרסה החדשה מהשרת..."
git pull origin claude/crm-login-screen-4g0sia || echo "(אזהרה: המשיכה נכשלה - ממשיך עם הגרסה הקיימת)"
echo ""
echo "[2/3] בודק התקנות..."
npm install --no-audit --no-fund
echo ""
echo "[3/3] מפעיל את המערכת - הדפדפן ייפתח לבד..."
echo ""
echo "  כדי לעצור: סגור את החלון הזה (ולחץ \"סיים\" אם תישאל)."
echo ""
npm run dev
